# Skopiuj ten plik jako secrets.yaml (obok wodomierze.yaml) i wpisz swoje wartosci.
# secrets.yaml jest w .gitignore - nie trafi do repo.

# OBOWIAZKOWE
wifi_ssid: "NazwaTwojejSieci"
wifi_password: "HasloDoWifi"

# Klucz szyfrowania API (wygeneruj: openssl rand -base64 32).
# Ten sam klucz zostanie pokazany/wpisany w Home Assistancie przy dodawaniu urzadzenia.
api_encryption_key: "WKLEJ_WYGENEROWANY_KLUCZ"

# Haslo wgrywania firmware po WiFi (dowolne, dlugie).
ota_password: "ZMIEN_MNIE"

# Haslo awaryjnej sieci WiFi plytki (min. 8 znakow), gdy nie widzi Twojej sieci.
ap_password: "ZMIEN_MNIE_AP"

# Login i haslo do strony WWW plytki.
web_username: "admin"
web_password: "ZMIEN_MNIE_WWW"
